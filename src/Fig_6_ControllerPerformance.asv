fig = figure('Color','w', ...
             'Units','pixels', ...
             'Position',[50 50 1250 400], ...
             'Renderer','painters');

t = tiledlayout(fig,1,4, ...
    'TileSpacing','compact', ...
    'Padding','loose');


lw  = 1.3;
clr1 = [0 0 0];
clr2 = [230/255 20/255   0/255];
clr3 = [0/255   200/255   0/255];
clr4 = [0/255   20/255   230/255];

idx_c = 8000;

Tau_c = Tau-Tau(idx_c);

ax1 = nexttile(t,1,[1 3]);
plot(Tau_c(1:size([Base_lift(1:8000,2);Mode_15(:,13)],1)), ...
    [Base_drag(1:8000,2);Mode_15(:,end)]/q, 'Color', clr4, 'LineWidth', lw); hold on

plot(Tau_c(1:size([Base_lift(1:8000,2);Mode_11(:,13)],1)), ...
    [Base_drag(1:8000,2);Mode_11(:,end)]/q, 'Color', clr3, 'LineWidth', lw)

plot(Tau_c(1:size([Base_lift(1:8000,2);Mode_8(:,13)],1)), ...
    [Base_drag(1:8000,2);Mode_8(:,end)]/q, 'Color', clr2, 'LineWidth', lw)
plot(Tau_c(1:size([Base_lift(1:8000,2);Mode_5(:,11)],1)), ...
    [Base_drag(1:8000,2);Mode_5(:,end)]/q, 'Color', clr1, 'LineWidth', lw)
plot(Tau_c(1:32000),ones(1,32000)*Min_drag/q,'k-.','LineWidth',1.5)
plot(Tau_c(1:32000),ones(1,32000)*Mean_Base_Drag/q,'r-.','LineWidth',1.5)
ylim([0.6 1.6])
grid on
xlabel('$\tau$',Interpreter='latex',FontSize=16)
ylabel('$C_\mathrm{d}$',Interpreter='latex',FontSize=16)
legend('Rank 15','Rank 11','Rank 8','Rank 5', ...
    'Interpreter','latex', ...
    'FontSize', 12, ...
    'Location','southwest', ...
    'Box','on');
grid(ax1, 'on');

text(ax1, ...
    0.1, 0.72,'$\bar{C}_\mathrm{d,base}$', ...
    'Units','normalized', ...
    'FontName','Times New Roman', ...
    'FontSize',18, ...
    'Color', [1,0,0], ...
    'BackgroundColor',[1,1,1], ....
    'FontWeight','bold', ...
    'HorizontalAlignment','left', ...
    'VerticalAlignment','top')

text(ax1, ...
    0.17, 0.27, '$\bar{C}_\mathrm{d,min}$', ...
    'Units','normalized', ...
    'FontName','Times New Roman', ...
    'FontSize',18, ...
    'Color', [0,0,0], ...
    'FontWeight','bold', ...
    'HorizontalAlignment','left', ...
    'VerticalAlignment','top')

text(ax1, ...
    0, 1.15, '(a)', ...
    'Units','normalized', ...
    'FontName','Times New Roman', ...
    'FontSize',18, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','left', ...
    'VerticalAlignment','top')

ax2 = nexttile(t,4);
scatter(4:16,[P_Saved{4:16}],42,'filled','ko',MarkerEdgeColor=[0 0 0])
grid on
%xlim([3 20])
ylim([-30 30])
xlabel('Truncation rank, $r$',Interpreter='latex',FontSize=16)
ylabel('$\zeta$',Interpreter='latex',FontSize=16)

text(ax2, ...
    0, 1.15, '(b)', ...
    'Units','normalized', ...
    'FontName','Times New Roman', ...
    'FontSize',18, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','left', ...
    'VerticalAlignment','top')

yl = ylim(ax2);

unstableRegion = patch(ax2, ...
    [17 20 20 17], ...
    [yl(1) yl(1) yl(2) yl(2)], ...
    [1 0 0], ...
    'FaceAlpha',0.18, ...   
    'EdgeColor','none', ...
    'HandleVisibility','off');

xline(ax2,17,'--', ...
    'Color',[1 0 0], ...
    'LineWidth',1.8, ...
    'HandleVisibility','off');

text(ax2,18.15,mean(yl),'unstable', ...
    'Rotation',90, ...
    'Color',[0 0 0], ...
    'FontName','Times New Roman', ...
    'FontSize',16, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','center', ...
    'VerticalAlignment','middle');

axs = [ax1 ax2];

set(axs, ...
    'FontName',      'Times New Roman', ...
    'FontSize',      18, ...
    'LineWidth',     1, ...
    'TickDir',       'in', ...
    'TickLabelInterpreter', 'latex', ...
    'XMinorTick',    'on', ...
    'YMinorTick',    'on', ...
    'XScale',        'linear', ...
    'Layer',         'bottom', ...
    'box','on');

pos = get(axs, 'Position');
set(axs,'Position',)

ax1.YLabel.Units = 'normalized';
ax2.YLabel.Units = 'normalized';

exportgraphics(gcf,"figures\Fig6.eps","ContentType","vector")