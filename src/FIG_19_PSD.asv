PSD = cell(1,4);
PSD{1} = Base_lift(:,2) / q;
PSD{2} = R75e_7(4000:end,end-5) / q;
PSD{3} = SRS_Base_Lift(:,2) / (2*q);
PSD{4} = SRS_Control(4000:end,end-5) / (2*q);
St_c = cell(1,4);
fs = 1/0.4;
labels = {'URANS Off','URANS On','DDES Off','DDES On'};

fig = figure('Color','w', ...
    'Units','pixels', ...
    'Position',[50 50 1250 400]);

t = tiledlayout(fig, 1, 2, ...
    'TileSpacing','compact', ...
    'Padding','compact');


cmap = [ ...
    0/255   0/255   0/255; ...
    230/255 20/255  0/255; ...
    0/255   0/255   0/255; ...
    230/255 20/255  0/255];

for i = 1:4
    n = length(PSD{i});
    winLen  = max(1024, floor(0.75*n));
    window  = hann(winLen);
    overlap = round(0.5*winLen);
    NFFT    = 2^nextpow2(max(winLen, n));

    [pxx{i}, St_c{i}] = pwelch(PSD{i}, window, overlap, NFFT, fs/U_inf);
end

ax1 = nexttile(t);
hold(ax1,'on')
colororder(ax1, cmap(1:2,:))
plot(ax1, St_c{1}, 20*log10(pxx{1}),'-', 'LineWidth', 1.5);
plot(ax1, St_c{2}, 20*log10(pxx{2}),'-.', 'LineWidth', 1.5);
grid(ax1,'on')
xlabel(ax1,'Strouhal number, $St$',Interpreter='latex')
ylabel(ax1,'PSD (dB)',Interpreter='latex')
legend(ax1, labels(1:2), 'Location', 'best','FontSize',12)
xlim(ax1,[0 1.4])
ylim(ax1,[-200 50])
text(ax1,0,1.25,'(a)', ...
    'Units','normalized', ...
    'FontName','Times New Roman', ...
    'FontSize',18, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','left', ...
    'VerticalAlignment','top');
ax2 = nexttile(t);
hold(ax2,'on')
colororder(ax2, cmap(3:4,:))
plot(ax2, St_c{3}, 20*log10(pxx{3}),'-', 'LineWidth', 1.5);
plot(ax2, St_c{4}, 20*log10(pxx{4}),'-.', 'LineWidth', 1.5);
grid(ax2,'on')
xlabel(ax2,'Strouhal number, $St$', Interpreter='latex')
%ylabel(ax2,'PSD/$St$', Interpreter='latex')
legend(ax2, labels(3:4), 'Location', 'best','FontSize',12)
xlim(ax2,[0 1.4])
ylim(ax2,[-200 50])
text(ax1,0,1.25,'(a)', ...
    'Units','normalized', ...
    'FontName','Times New Roman', ...
    'FontSize',18, ...
    'FontWeight','bold', ...
    'HorizontalAlignment','left', ...
    'VerticalAlignment','top');
set([ax1 ax2], ...
    'FontName', 'Times New Roman', ...
    'FontSize', 18, ...
    'LineWidth', 1, ...
    'TickDir', 'in', ...
    'TickLabelInterpreter', 'latex', ...
    'XMinorTick', 'on', ...
    'YMinorTick', 'on', ...
    'XScale', 'linear', ...
    'Layer', 'bottom', ...
    'Box', 'on');

exportgraphics(gcf,"figures\Fig19.pdf","ContentType","vector")